DATABASE_URL="postgresql://asclajen:asclajen@localhost:5432/asclajen"
# Vorführung: 1 = Stripe-Test-Checkout in der App (Karte 4242 4242 4242 4242).
# Sobald STRIPE_SECRET_KEY ein echter sk_test_-Schlüssel ist, öffnet sich Stripe selbst.
SHOWCASE_MODE="1"
AUTH_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:4521"

# Banküberweisung: pro Sektion ausschließlich als Environment-Variable setzen.
# Der nicht-geheime Key (z. B. TENNIS) wird unter Admin → Sektionen gepflegt.
# PAYMENT_TENNIS_BANK_IBAN="IT00X0000000000000000000000"
# PAYMENT_TENNIS_BANK_ACCOUNT_HOLDER="ASC Lajen Tennis"

# Stripe: Secrets pro Sektion ausschließlich als Environment-Variable setzen.
# PAYMENT_TENNIS_STRIPE_SECRET_KEY="sk_test_..."   # oder rk_test_... / sk_live_... / rk_live_...
# PAYMENT_TENNIS_STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY wird nicht genutzt (Hosted Checkout).
# Geschätzte Stripe-Gebühren für Buchhaltung (Standard EU-Karte: 1,5 % + 0,25 €).
# STRIPE_FEE_PERCENT="1.5"
# STRIPE_FEE_FIXED_CENTS="25"
# Optional. Empfänger für „erstes Ticket des Tages“-Mail (Standard: fabian@wegaplan.com).
# SUPPORT_TICKET_NOTIFY_EMAIL="fabian@wegaplan.com"

# Transactional mail – auf Render Free SMTP-Ports (587/465) oft BLOCKIERT → hängt.
# Deshalb HTTPS-API nutzen (Brevo).

# Empfohlen: Brevo (https://app.brevo.com)
# 1. Domain asclajen.com in Brevo verifizieren (DNS: SPF/DKIM) ODER Absender app@asclajen.com freischalten
# 2. API-Key unter SMTP & API erstellen
# BREVO_API_KEY="xkeysib-..."
# MAIL_FROM="ASC Lajen <app@asclajen.com>"
# MAIL_PROVIDER="brevo"
# SMTP_* und RESEND_API_KEY können dann weg.

# Alternative: Resend (eigene Domain nötig, nicht @gmail.com)
# RESEND_API_KEY="re_..."
# MAIL_FROM="ASC Lajen <app@asclajen.com>"

# SMTP nur lokal oder auf bezahltem Render-Plan:
# SMTP_HOST="smtp.…"
# SMTP_PORT="587"
# SMTP_USER="app@asclajen.com"
# SMTP_PASS="…"
# MAIL_FROM="ASC Lajen <app@asclajen.com>"

# Schützt /api/cron/renew-subscriptions und /api/cron/registration-backup.
# In render.yaml: Web + Cron „asclajen-renewals“ + „asclajen-registration-backup“.
# Lokal optional; auf Render per Blueprint (generateValue) setzen.
# CRON_SECRET="langer-zufallsstring"
# Optional. Empfänger für das zweimal wöchentliche Abos/Kurse-Excel-Backup
# (Standard: info@asclajen.com). Mehrere Adressen mit Komma.
# REGISTRATION_BACKUP_EMAIL="info@asclajen.com"

# Optional. Speicherort für hochgeladene Atteste (Standard: ./uploads im Projektverzeichnis).
UPLOAD_DIR=/var/data/uploads

# Optional. Hosting-Überwachung (Admin → Hosting) mit echten Render-Metriken.
# API-Key: Render Dashboard → Account Settings → API Keys
# Service-/DB-IDs: aus der URL der jeweiligen Resource (srv-… / dpg-…)
# RENDER_API_KEY="rnd_..."
# RENDER_SERVICE_ID="srv-..."
# RENDER_POSTGRES_ID="dpg-..."
